# Copy to .env.local (git-ignored) and adjust.
# Backend base URL (default http://127.0.0.1:8000)
VITE_API_BASE=http://127.0.0.1:8000
# Must match the backend LOCAL_AGENT_TOKEN; leave empty when backend auth is off.
# NOTE: Vite inlines VITE_* values into the built JS bundle — use this only for
# local protection, never for a real secret on a shared/public build.
VITE_AGENT_TOKEN=
