APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_PATH=data/workflow.sqlite3

# DeepSeek (OpenAI-compatible) chat completions
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Agent execution limits
AGENT_MAX_ITERATIONS=15
TOOL_TIMEOUT_SECONDS=60
TASK_TIMEOUT_SECONDS=900
TOOL_OUTPUT_MAX_CHARS=8000
# Upper bound for a model-supplied run_project_command timeout_seconds; the
# command's process tree is killed when exceeded.
MAX_COMMAND_TIMEOUT_SECONDS=600

# Approval behavior. REQUIRE_APPROVAL=false auto-authorizes approval-requiring
# tools (still logged); hard security rejections are never relaxed.
REQUIRE_APPROVAL=true
APPROVAL_WAIT_SECONDS=300
# How long a run waits for the user's answer to an ask_user question.
INPUT_WAIT_SECONDS=600

# Write protection: pre-write snapshots + rollback records. This directory must
# stay OUTSIDE the agent workspace (the guard falls back automatically if it is
# configured inside it). Contains original file bytes, including protected files.
# WRITE_BACKUP_DIR=/absolute/path/to/write_backups
# Whole-file rewrite guard: refuse to replace a file larger than this many chars
# when the new content is under this ratio of the original.
WRITE_SHRINK_GUARD_MIN_CHARS=1000
WRITE_SHRINK_GUARD_RATIO=0.5

# Local API authentication (shared token). Empty = auth disabled (local dev).
# Set a random value and send it as ``Authorization: Bearer <token>`` to protect
# the API. Not a production identity system. The web UI sends it when
# frontend/.env.local sets VITE_AGENT_TOKEN to the same value.
LOCAL_AGENT_TOKEN=

# Browser origins allowed by CORS (comma separated). Default: the local Vite
# dev-server ports 5173-5175 on localhost and 127.0.0.1.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: restrict the agent's filesystem boundary (defaults to project root)
# WORKSPACE_PATH=/absolute/path/to/project

# ---- Task-graph workflow (v0.3.0+) ----
# Decompose the goal into a subtask DAG with the model (false = single-subtask mode).
PLANNER_ENABLED=true
# Optional LLM split for a single multi-requirement goal clause (default false;
# offline tests stay deterministic). Requires PLANNER_ENABLED.
GOAL_CLAUSE_LLM_SPLIT=false
# Pause for the user to approve/reject/edit the plan (and structural replans).
PLAN_REQUIRES_APPROVAL=true
MAX_SUBTASKS=8
# Total replans (rewrite-remaining + structural) before the run fails.
MAX_REPLANS=2
# Attempts per subtask for transient failures (timeout/crash/lock/429/5xx).
MAX_SUBTASK_ATTEMPTS=3
# Plan rejections (with feedback) before the run needs attention.
MAX_PLAN_REJECTIONS=3
PLANNER_OVERVIEW_MAX_CHARS=4000
# Add a model review of combined result vs. original goal to the final verify.
FINAL_VERIFY_LLM=true
# Per-subtask executor budgets.
SUBTASK_MAX_ITERATIONS=20
SUBTASK_TIMEOUT_SECONDS=600
# Run-level circuit breakers -> status needs_attention with a reason.
MAX_RUN_STEPS=200
MAX_RUN_SECONDS=3600
MAX_RUN_TOKENS=2000000
# Execution lease: expired heartbeat = crashed attempt (idempotent recovery).
LEASE_TTL_SECONDS=120
LEASE_HEARTBEAT_SECONDS=10
# Parallel subtasks: at most this many ready subtasks whose write_scope do not
# overlap run at once (1 = strictly serial).
MAX_PARALLEL=2
# Cost estimate (per 1K tokens); adjust to your actual model price.
TOKEN_PRICE_INPUT_PER_1K=0.002
TOKEN_PRICE_OUTPUT_PER_1K=0.008
COST_CURRENCY=CNY

# ---- Write-scope artifacts (v0.3.3) ----
# allow | restore | fail — how to treat changes under ARTIFACT_PATH_GLOBS after commands.
ARTIFACT_POLICY=allow
# Comma-separated globs (defaults cover dist/build/.next/coverage/__pycache__/…).
# ARTIFACT_PATH_GLOBS=dist/**,build/**,.next/**,coverage/**,**/__pycache__/**

# ---- Final-verify replan (v0.3.3) ----
FINAL_VERIFY_REPLAN=true
FINAL_VERIFY_MAX_REPLANS=1

# ---- Soft command sandbox / legacy scopes (v0.3.4) ----
# Snapshot + TMP redirect + refuse absolute argv outside workspace (not a kernel jail).
COMMAND_SOFT_SANDBOX=true
# Legacy plans missing write_scope: true = block modify until PATCH; false = migrate to **.
LEGACY_WRITE_SCOPE_STRICT=true

# ---- Edge harden (v0.3.5) ----
# Read/overall ceiling for one chat() call (seconds).
# LLM_TIMEOUT_SECONDS=120
# Connect/write/pool timeout; cancel should not wait for full read timeout.
LLM_CONNECT_TIMEOUT_SECONDS=10
# While chat() is in flight, re-check CancelToken this often (ms) and close client.
CANCEL_FORCE_MS=500
# Frontend poll when SSE disconnected / connected (backend documents intent; UI hardcodes defaults).
# SSE_POLL_FALLBACK_MS=2000
# SSE_POLL_ACTIVE_MS=8000
# Soft sandbox extras (defense in depth, not a container):
COMMAND_DENY_NETWORK=false
COMMAND_READONLY_FS_HINT=true

# ---- Residual mitigations (v0.3.6) ----
# Durable SSE: replay with ?after_seq=; DB-tail so workers can read events (prefer workers=1).
EVENTS_DB_TAIL=true
EVENTS_DB_TAIL_MS=500
# After cancel, briefly wait for httpx close before abandoning the daemon thread (ms).
CANCEL_JOIN_MS=1000
# Force approval for curl/wget/Invoke-WebRequest / python urllib|socket patterns.
COMMAND_BLOCK_NETWORK_TOOLS=true
# When true: strip proxies + inject Python sitecustomize socket block (not a firewall).
# COMMAND_DENY_NETWORK=false
